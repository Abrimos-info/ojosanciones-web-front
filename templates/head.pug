mixin buscador
    section.buscador(role="search", id="buscador", aria-label="Búsqueda de sanciones")
        form(action="/buscador", method="get", aria-label="Formulario de búsqueda")
            fieldset
                legend.sr-only Configuración de búsqueda
                each filter, id in filters
                    case filter.type
                        when "exact-string"
                        when "text"
                            div(style="display: inline-block")
                                label(for=id) !{filter.label}
                                i.fi.fi-rr-search(aria-hidden="true")
                                input(type="text", name=id, id=id, value=filter.value, placeholder=filter.prompt, aria-label=filter.label, aria-describedby=id + "-help")
                        when "select"
                            div(style="display: inline-block")
                                label(for=id) !{filter.label}
                                select(name=id, id=id, title=filter.prompt, aria-label=filter.label, aria-describedby=id + "-help")
                                    for option in filter.options
                                        if (option.label)
                                            if (filter.value==option.value)
                                                option(selected="selected", value=option.value) !{option.label}
                                            else
                                                option(value=option.value) !{option.label}
                button(type="submit", aria-label="Ejecutar búsqueda").primaryButtonLarge Buscar


