            li 
                a.secondaryButtonLarge(href="https://t.me/share/url?url="+enc("Por favor revisa estas sanciones https://ojosanciones.sociedad.info/mx/empresa/" + id + ""), target="_blank", aria-label="Compartir por Telegram")
                    i.fi.fi-brands-telegram(aria-hidden="true")
                    span Compartir
            li 
                a.secondaryButtonLarge(href="/datos", aria-label="Descargar datos")
                    i.fi.fi-rr-download(aria-hidden="true")
